# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HitPay (Dashboard > Payment Gateway > API Keys)
HITPAY_API_KEY=your-business-api-key
# "sandbox" (default) or "production"
HITPAY_ENV=sandbox

# HitPay Event Webhook salt (Dashboard > API Keys > Event Webhook > your
# webhook's detail view) — verifies the Hitpay-Signature header on
# app/api/webhooks/hitpay. Only needed once you register that webhook.
HITPAY_WEBHOOK_SALT=

# Gmail SMTP for the CRM email sequence (Google Account > Security >
# 2-Step Verification > App passwords — requires 2FA enabled on the account)
GMAIL_USER=kaho.ferments@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Shared secret for /api/cron/run-sequences — pick any random string
CRON_SECRET=your-random-cron-secret

# Password for the /admin sequence editor
ADMIN_PASSWORD=your-admin-password

# Used to build the birthday-capture link in emails. Set to your real domain in production.
APP_BASE_URL=http://localhost:3000
